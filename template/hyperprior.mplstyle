# Dimensions are the final printed size of a single column.
figure.figsize: 3.164, 2.4
figure.dpi: 150
figure.facecolor: white
figure.autolayout: False
font.family: serif
font.serif: XCharter, DejaVu Serif
font.size: 8
axes.titlesize: 9
axes.labelsize: 8
axes.labelcolor: 242424
axes.edgecolor: 8a8a8a
axes.linewidth: 0.5
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['8e1b1e', '0072b2', '5a5a5a', 'b3b3b3'])
axes.axisbelow: True
axes.grid: False
axes.unicode_minus: True
xtick.labelsize: 7
xtick.color: 4a4a4a
xtick.major.size: 2.5
xtick.major.width: 0.5
ytick.labelsize: 7
ytick.color: 4a4a4a
ytick.major.size: 2.5
ytick.major.width: 0.5
grid.color: dddddd
grid.linewidth: 0.4
lines.linewidth: 1.2
lines.markersize: 3.5
legend.fontsize: 7
legend.frameon: False
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path
savefig.facecolor: white
savefig.pad_inches: 0.02
