  {
   "kind": "scalar",
   "entry": "funds",
   "lower": 0,
   "upper": null,
   "source": "totalFunds changes only in spend/setFunds (src/micropolis.cpp:1066-1081): a tool is refused when totalFunds < cost (src/tool.cpp:154, charged at :127); the budget pays at most taxFund + totalFunds, otherwise nothing and auto-budget switches off (src/budget.cpp:124-230, 268-310); setFunds is otherwise called only at load or reset",
   "caveat": "spend/setFunds take a 32-bit int: holds below 2,147,483,647"
  },
  {
   "kind": "scalar",
   "entry": "res_valve",
   "lower": -2000,
   "upper": 2000,
   "source": "clamp to +-RES_VALVE_RANGE (src/simulate.cpp:671; = 2000, src/micropolis.h:286)",
   "caveat": ""
  },
  {
   "kind": "scalar",
   "entry": "com_valve",
   "lower": -1500,
   "upper": 1500,
   "source": "clamp to +-COM_VALVE_RANGE (src/simulate.cpp:672; = 1500, src/micropolis.h:287)",
   "caveat": ""
  },
  {
   "kind": "scalar",
   "entry": "ind_valve",
   "lower": -1500,
   "upper": 1500,
   "source": "clamp to +-IND_VALVE_RANGE (src/simulate.cpp:673; = 1500, src/micropolis.h:288)",
   "caveat": ""
  },
  {
   "kind": "scalar",
   "entry": "res_pop",
   "lower": 0,
   "upper": null,
   "source": "zeroed by the census (src/simulate.cpp:699), then += zone population 0..40 (src/zone.cpp:556-562, 711-715)",
   "caveat": "16-bit short: would wrap only above 32,767 (more than 819 fully grown residential zones)"
  },
  {
   "kind": "scalar",
   "entry": "com_pop",
   "lower": 0,
   "upper": null,
   "source": "zeroed by the census (src/simulate.cpp:700), then += zone population 0..5 (src/zone.cpp:774, 866-873)",
   "caveat": ""
  },
  {
   "kind": "scalar",
   "entry": "ind_pop",
   "lower": 0,
   "upper": null,
   "source": "zeroed by the census (src/simulate.cpp:701), then += zone population 0..4 (src/zone.cpp:926, 1001-1008)",
   "caveat": ""
  },
  {
   "kind": "scalar",
   "entry": "score",
   "lower": 0,
   "upper": 1000,
   "source": "cityScore = (cityScore + clamp(z, 0, 1000)) / 2 (src/evaluate.cpp:464-466); starts at 500 (src/evaluate.cpp:155, src/initialize.cpp:94); a loaded score outside 1..999 becomes 500 (src/simulate.cpp:504-506)",
   "caveat": ""
  },
  {
   "kind": "scalar",
   "entry": "tax_fund",
   "lower": 0,
   "upper": null,
   "source": "totalPop * landValueAverage / 120 * cityTax * FLevels, all factors non-negative (src/simulate.cpp:887); 0 at src/simulate.cpp:559",
   "caveat": ""
  },
  {
   "kind": "scalar",
   "entry": "road_spend",
   "lower": 0,
   "upper": null,
   "source": "set to an allocation min(fund x percent, cash left) or to the fund (src/budget.cpp:115-230, 280-282, 306-308); percents clamped to [0, 1] (c_api.cpp:139-141)",
   "caveat": ""
  },
  {
