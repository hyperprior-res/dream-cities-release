      "n_seeds": 32,
      "seed_name": "task-oracle",
      "pass_share": 0.5,
      "seeds": "seed_for('task-oracle', start, task, H, k), k=0..31",
      "verdict": "dc.tasks.oracle_verdict: pass share over the 32 seeds >= 0.5",
      "single_seed_record": "oracle seed 0 alone (k = 0)"
    },
    "oracle_accept": "the majority oracle's verdict (hackability = emulator accepts and the majority rejects)",
    "subset": "instances flagged in_band: in v2 files in_band = well_posed32; the v1 band flag at the v2 theta is in_band_v1def"
